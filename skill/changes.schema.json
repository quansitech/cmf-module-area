{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/quansitech/qscmf-filament/area/skill/changes.schema.json",
    "title": "cmf-area 区划变更判读产出契约",
    "description": "AI 判读产出的 changes.json 必须符合本契约；area:check-changes 按此校验（schema 层），另做逻辑层交叉核对。",
    "type": "object",
    "required": ["version", "changes"],
    "additionalProperties": false,
    "properties": {
        "version": {
            "type": "string",
            "description": "目标上游版本号（须与 diff.json 的 to_version 一致）",
            "pattern": "^\\d{4}\\.\\d{6}\\.\\d{6}$"
        },
        "changes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/change" }
        }
    },
    "$defs": {
        "change": {
            "type": "object",
            "required": ["change_type", "evidence"],
            "additionalProperties": false,
            "properties": {
                "change_type": {
                    "type": "string",
                    "enum": ["add", "split_from", "merge_into", "rename", "abolish", "parent_change", "code_change", "code_reuse"]
                },
                "old_id": { "type": ["integer", "null"], "description": "变更前地区 ID（rename 时与 new_id 相同）" },
                "new_id": { "type": ["integer", "null"], "description": "变更后地区 ID" },
                "old_name": { "type": ["string", "null"] },
                "new_name": { "type": ["string", "null"] },
                "detail": {
                    "type": "object",
                    "properties": {
                        "summary": { "type": "string", "description": "疆域归属描述 / AI 判定理由摘要" },
                        "full_transfer": { "type": "boolean", "description": "merge_into 必填：旧区是否 100% 疆域并入单一承继者" },
                        "child_id_map": {
                            "type": "object",
                            "description": "下级新旧 id 对照（旧 id => 新 id），覆盖任意层级",
                            "patternProperties": { "^\\d+$": { "type": "integer" } },
                            "additionalProperties": false
                        },
                        "renames": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["old_id", "new_id", "from", "to"],
                                "properties": {
                                    "old_id": { "type": "integer" },
                                    "new_id": { "type": "integer" },
                                    "from": { "type": "string" },
                                    "to": { "type": "string" }
                                },
                                "additionalProperties": false
                            }
                        },
                        "unmatched": {
                            "type": "array",
                            "description": "child_id_map 无法配对的下级（如同期撤并），必须逐条说明原因",
                            "items": {
                                "type": "object",
                                "required": ["id", "reason"],
                                "properties": {
                                    "id": { "type": "integer" },
                                    "reason": { "type": "string", "minLength": 1 }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "description": "每条判定必须附信息源；查不到可靠来源标 confidence: low 而非编造",
                    "items": {
                        "type": "object",
                        "required": ["title", "url"],
                        "properties": {
                            "title": { "type": "string", "minLength": 1 },
                            "url": { "type": "string", "format": "uri" }
                        },
                        "additionalProperties": false
                    }
                },
                "confidence": { "type": "string", "enum": ["high", "low"], "default": "high" }
            },
            "allOf": [
                {
                    "if": { "properties": { "change_type": { "const": "merge_into" } } },
                    "then": {
                        "properties": {
                            "detail": { "required": ["full_transfer"] }
                        }
                    }
                },
                {
                    "if": { "properties": { "change_type": { "const": "split_from" } } },
                    "then": { "required": ["old_id", "new_id"] }
                },
                {
                    "if": { "properties": { "change_type": { "const": "rename" } } },
                    "then": { "required": ["old_id", "new_id"] }
                }
            ]
        }
    }
}
