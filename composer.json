{
    "name": "quansitech/cmf-module-area",
    "description": "QS CMF 行政区划模块：内置四级行政区划数据（省市区乡镇）、业务引用登记（merge_strategy）、上游变更 AI 升级流水线（diff → 判读 → 校验 → 延迟绑定迁移）",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "quansitech/cmf-core": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Quansitech\\Cmf\\Area\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quansitech\\Cmf\\Area\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quansitech\\Cmf\\Area\\AreaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off vendor/bin/pest",
        "test:parallel": "XDEBUG_MODE=off vendor/bin/pest --parallel"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
